@page "/players/{slug}"
@using Humanizer
@using MagicMatchTracker.Client.Infrastructure.Pages
@inject MockDataProvider DataProvider

@if (_player is null)
{
	<NotFound/>
	return;
}

<div class="card flex gap-(--card-padding) mb-4">
	<Avatar Uri="@_player.AvatarUri" Size="24"/>
	<div class="flex-1 flex flex-col gap-2">
		<h1>@_player.Username</h1>
		<div class="flex-1 flex items-end">
			<button class="button">
				<span class="icon">edit</span>
				<span>Edit</span>
			</button>
		</div>
	</div>
</div>

<div class="grid grid-cols-2 gap-4">
	<BigStat
		Label="Matches"
		Value="_player.Matches"
		Icon="swords"
		Link="@($"/sessions?player={_player.Slug}")"/>

	<BigStat
		Label="Decks"
		Value="_player.Decks"
		Icon="box"
		Link="@($"/players/{_player.Slug}/decks")"/>

	@if (_player.WinRate is not null)
	{
		<BigStat
			Label="Win Rate"
			Value="_player.FormattedWins"
			Icon="trophy"
			ToolTip="@("win".ToQuantity(_player.Wins))"/>
	}
	else
	{
		<BigStat
			Label="Wins"
			Value="_player.Wins"
			Icon="trophy"/>
	}
</div>

@code {

	private Player? _player;

	[Parameter, EditorRequired]
	public string Slug { get; set; }

	protected override void OnParametersSet()
	{
		_player = DataProvider.Players.FindBySlug(Slug, p => p.Slug);
	}

}