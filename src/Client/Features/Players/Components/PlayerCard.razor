@using MagicMatchTracker.Client.Features.Common.Components
@using MagicMatchTracker.Client.Infrastructure.Components
<a class="card interactive p-4 flex flex-col gap-4" href="/players/@Player.Slug">
	<div class="flex flex-col items-center gap-2">
		<Avatar Uri="@Player.AvatarUri" Size="20"/>
		<span>@Player.Username</span>
	</div>
	<div class="grid grid-cols-3 text-sm text-on-surface-muted">
		<CardStat Value="Player.Matches" Icon="swords"/>
		<CardStat Value="Player.FormattedWins" Icon="trophy" ToolTip="@($"{Player.Wins} wins")"/>
		<CardStat Value="Player.Decks" Icon="box"/>
	</div>
</a>

@code {

	[Parameter, EditorRequired]
    public Player Player { get; set; }

}