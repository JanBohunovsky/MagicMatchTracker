@page "/sessions/{id}"
@using MagicMatchTracker.Client.Features.Common.Extensions
@using MagicMatchTracker.Client.Infrastructure.Pages
@inject MockDataProvider DataProvider

@if (_session is null)
{
	<NotFound/>
	return;
}

@if (_session != DataProvider.Sessions.GetActiveSession())
{
	@* Show summary directly for past matches *@
	<SessionSummary Session="_session"/>
	return;
}

<div class="flex items-center justify-between">
	<div class="flex items-center gap-2">
		<IconButton Icon="arrow_back" Link="/"/>
		<h1>@_session.FormattedDate</h1>
	</div>
</div>

@code {

	private Session? _session;

	[Parameter, EditorRequired]
	public string Id { get; set; }

	protected override void OnParametersSet()
	{
		_session = DataProvider.Sessions.FindById(Id, s => s.Id);
	}

}