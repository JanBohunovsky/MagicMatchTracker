@page "/sessions/{slug}"
@using MagicMatchTracker.Client.Features.Sessions.Components
@using MagicMatchTracker.Client.Infrastructure.Pages
@inject MockDataProvider DataProvider

@if (_session is null)
{
	<NotFound/>
	return;
}

<div class="card flex flex-col gap-(--card-padding) mb-(--page-padding)">
	<div class="flex flex-row justify-between items-baseline">
		<h1 class="flex flex-col">
			<span>@_session.Date.ToString("MMMM d")</span>
			<span class="text-xl text-on-surface-muted">@_session.Date.ToString("dddd")</span>
		</h1>
		@if (_formattedDuration is not null)
		{
			<CardStat Icon="timer" Value="_formattedDuration" Orientation="Orientation.Horizontal" class="text-sm text-on-surface-muted"/>
		}
	</div>

	<div class="grid grid-cols-4 gap-x-3 gap-y-6">
		@foreach (var player in _session.SeatedPlayers)
		{
			<div class="flex flex-col items-center gap-1 text-sm">
				<Avatar Uri="@player.AvatarUri" Size="12"/>
				<span>@player.Username</span>
			</div>
		}
	</div>

	<div class="flex flex-row gap-3">
		<button class="button">
			<span class="icon">patient_list</span>
			<span>Players</span>
		</button>
		<button class="button">
			<span class="icon">edit</span>
			<span>Edit</span>
		</button>
	</div>
</div>

<div class="flex flex-col gap-(--page-padding)">
	@foreach (var match in _session.Matches)
	{
		<MatchCard Match="match"/>
	}
</div>

@code {

	private Session? _session;
	private string? _formattedDuration;

	[Parameter, EditorRequired]
    public string Slug { get; set; }

	protected override void OnParametersSet()
	{
		_session = DataProvider.Sessions.FindBySlug(Slug, s => s.Slug);
		if (_session is null)
			return;

		_formattedDuration = _session.GetFormattedDuration();
	}

}