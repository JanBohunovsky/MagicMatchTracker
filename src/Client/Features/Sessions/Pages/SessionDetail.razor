@page "/sessions/{slug}"
@using MagicMatchTracker.Client.Features.Sessions.Components
@using MagicMatchTracker.Client.Infrastructure.Pages
@inject MockDataProvider DataProvider

@if (_session is null)
{
	<NotFound/>
	return;
}

<div class="card flex flex-col gap-(--card-padding) mb-(--page-padding)">
	<div class="flex flex-row justify-between items-baseline">
		<div>
			<h1>@_session.Date.ToString("MMMM d")</h1>
			<span class="text-lg text-muted">@_session.Date.ToString("dddd")</span>
		</div>
		<CardStat Icon="timer" Value="_session.GetFormattedDuration()" Orientation="Orientation.Horizontal" class="text-sm text-muted"/>
	</div>

	<div class="grid grid-cols-4 gap-x-3 gap-y-6">
		@foreach (var sessionPlayer in _session.Players.OrderBy(sp => sp.SeatNumber))
		{
			<div class="flex flex-col items-center gap-1 text-sm">
				<Avatar Uri="@sessionPlayer.Player.AvatarUri" Size="12"/>
				<span>@sessionPlayer.Player.Username</span>
			</div>
		}
	</div>

	<div class="flex flex-row gap-3">
		<button class="button flex-1">
			<span class="icon">patient_list</span>
			<span>Players</span>
		</button>
		<button class="button flex-1">
			<span class="icon">edit</span>
			<span>Edit</span>
		</button>
		<button class="button flex-1 min-w-fit @(_isToday ? "inverted-component" : string.Empty)">
			<span class="icon">add</span>
			<span>New Match</span>
		</button>
	</div>
</div>

<div class="flex flex-col gap-(--page-padding)">
	@foreach (var match in _session.Matches)
	{
		<MatchCard Match="match"/>
	}
</div>

@code {

	private Session? _session;
	private bool _isToday;

	[Parameter, EditorRequired]
    public string Slug { get; set; }

	protected override void OnParametersSet()
	{
		_session = DataProvider.Sessions.FindBySlug(Slug, s => s.Slug);
		if (_session is null)
			return;

		_isToday = _session.Date == DateOnly.FromDateTime(DateTime.Today);
	}

}