<div class="card flex flex-col gap-3">
	<div class="flex flex-col items-center gap-2 flex-1">
		<div class="flex -space-x-5 *:ring-4 *:ring-surface *:bg-surface *:rounded-full">
			<Image
				Uri="@Participation.Player.AvatarUri"
				Size="20"
				PlaceholderIcon="person"
				ContainerClass="z-1"/>
			<Image
				Uri="@Participation.Deck.ImageUri"
				Size="20"
				PlaceholderIcon="box"
				class="h-full object-cover"/>
		</div>

		<div class="flex flex-col items-center">
			<span>@Participation.Player.Username</span>
			<span class="text-muted">@Participation.Deck.Title</span>
		</div>

		<div class="mt-2 flex flex-col items-center gap-1.5 text-sm flex-1 justify-center">
			<span class="flex gap-1">
				<span class="icon @(Participation.IsWinner ? "icon-filled" : string.Empty)">
					@(Participation.IsWinner ? "trophy" : Participation.EliminationReason?.Icon ?? "skull")
				</span>
				<span>@(Participation.IsWinner ? "Winner" : Participation.EliminationReason?.DisplayName ?? "Eliminated")</span>
			</span>

			@if (Participation.EliminatedBy is not null)
			{
				<span class="flex gap-1.5">
					<Avatar Uri="@Participation.EliminatedBy.AvatarUri" Size="5"/>
					<span>by @Participation.EliminatedBy.Username</span>
				</span>
			}

			@if (Participation.EndTurn is not null)
			{
				<span class="flex gap-1">
					<span class="icon">timer</span>
					<span>on turn @Participation.EndTurn</span>
				</span>
			}
		</div>
	</div>
</div>

@code {

	[Parameter, EditorRequired]
    public MatchParticipation Participation { get; set; }

}