@using Humanizer
<div class="card flex flex-col gap-3">
	<div class="flex flex-col items-center gap-2 flex-1">
		<div class="flex items-center -space-x-4 *:ring-4 *:ring-surface *:bg-surface">
			<Image
				Uri="@Participation.Player.AvatarUri"
				Size="20"
				PlaceholderIcon="person"
				ContainerClass="z-1 rounded-full"/>
			<Image
				Uri="@Participation.Deck.ImageUri"
				Height="16"
				Width="18"
				PlaceholderIcon="box"
				ContainerClass="rounded-e-component"
				class="h-full object-cover"/>
		</div>

		<div class="flex flex-col items-center">
			<span>@Participation.Player.Username</span>
			<span class="text-muted">@Participation.Deck.Title</span>
		</div>

		<div class="mt-1 p-2 self-stretch flex flex-col items-center gap-1.5 text-sm flex-1 justify-center rounded-xl @(Participation.IsWinner ? "bg-highlight-on-component text-on-highlight-on-component" : "bg-neutral-100 dark:bg-neutral-700/50")">
			<div class="flex gap-1">
				@if (Participation.IsWinner)
				{
					<span class="icon icon-filled">trophy</span>
					<span>Winner</span>
				}
				else
				{
					<span class="icon">@(Participation.EliminationReason?.Icon ?? "skull")</span>
					<span>
						@(Participation.EliminationReason?.DisplayName ?? "Eliminated")
						@(Participation.EliminatedBy is not null ? "by" : string.Empty)
					</span>
					@if (Participation.EliminatedBy is not null)
					{
						<Avatar Uri="@Participation.EliminatedBy.AvatarUri" Size="5"/>
					}
				}
			</div>
			@if (Participation.EndTurn is not null)
			{
				<span class="flex gap-1 text-muted">
					<span class="icon">laps</span>
					<span>@("turn".ToQuantity(Participation.EndTurn.Value))</span>
				</span>
			}
		</div>
	</div>
</div>

@code {

	[Parameter, EditorRequired]
    public MatchParticipation Participation { get; set; }

}