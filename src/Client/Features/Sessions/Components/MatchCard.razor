<a class="card interactive flex flex-col gap-(--card-padding)" href="/sessions/@Match.Session.Slug/@Match.Slug">
	<div class="flex justify-between">
		<span class="text-lg">Match #@Match.Number</span>
		<div class="flex gap-3 text-muted text-sm">
			<CardStat Icon="timer" Value="Match.GetFormattedDuration()"/>
		</div>
	</div>

	<div class="grid grid-cols-2 gap-3">
		@foreach (var participation in Match.Participations.OrderBy(mp => mp.TurnOrder))
		{
			<div class="flex flex-row items-center gap-2 text-sm rounded-full @(participation.IsWinner ? "bg-amber-100 dark:bg-amber-400/10 text-amber-800 dark:text-amber-200" : "bg-neutral-100 dark:bg-neutral-700/50")">
				<Avatar Uri="@participation.Player.AvatarUri" Size="10"/>

				<div class="flex-1 flex flex-col text-sm/tight">
					<span>@participation.Player.Username</span>
					<span class="text-muted">@participation.Deck.Title</span>
				</div>

				<div class="me-1 grid place-items-center size-8 rounded-full"
				     title="@participation.BuildDescription()">
					@if (participation.IsWinner || participation.EliminatedBy is null)
					{
						<span class="icon text-current/80 @(participation.IsWinner ? "icon-filled" : string.Empty)">
							@(participation.IsWinner ? "trophy" : participation.EliminationReason?.Icon ?? "skull")
						</span>
					}
					else
					{
						<Avatar Uri="@participation.EliminatedBy.AvatarUri" Size="5"/>
					}
				</div>
			</div>
		}
	</div>
</a>

@code {

	[Parameter, EditorRequired]
	public Match Match { get; set; }

}