<a class="card interactive flex flex-col gap-(--card-padding)" href="/sessions/@Session.Slug">
	<div class="flex justify-between">
		<div class="flex gap-2 items-baseline">
			<span class="text-lg">@Session.Date.ToString("MMMM d")</span>
			<span class="text-on-surface-muted">@Session.Date.ToString("dddd")</span>
		</div>
		<div class="flex gap-3 text-on-surface-muted text-sm">
			@if (_formattedDuration is not null)
			{
				<CardStat Icon="timer" Value="_formattedDuration" Orientation="Orientation.Horizontal"/>
			}
			<CardStat Icon="swords" Value="Session.Matches.Count" Orientation="Orientation.Horizontal"/>
		</div>
	</div>

	<div class="grid grid-cols-4 gap-x-3 gap-y-6">
		@foreach (var player in Session.SeatedPlayers)
		{
			<div class="flex flex-col items-center gap-1 text-sm">
				<Avatar Uri="@player.AvatarUri" Size="12"/>
				<span class="">@player.Username</span>
				@{
					var wins = Session.Matches
						.SelectMany(m => m.Participations)
						.Where(p => p.PlayerSlug == player.Slug)
						.Count(p => p.IsWinner is true);
				}
				@if (wins > 0)
				{
					<div class="flex text-on-surface-muted">
						@for (var i = 0; i < wins; i++)
						{
							<span class="icon">trophy</span>
						}
					</div>
				}
			</div>
		}
	</div>
</a>

@code {

	private string? _formattedDuration;

	[Parameter, EditorRequired]
    public Session Session { get; set; }

	protected override void OnParametersSet()
	{
		_formattedDuration = Session.GetFormattedDuration();
	}

}