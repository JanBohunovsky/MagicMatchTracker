<a class="card interactive flex flex-col gap-(--card-padding)" href="/sessions/@Session.Slug">
	<div class="flex justify-between">
		<div class="flex gap-2 items-baseline">
			<span class="text-lg">@Session.Date.ToString("MMMM d")</span>
			<span class="text-muted">@Session.Date.ToString("dddd")</span>
		</div>
		<div class="flex gap-3 text-muted text-sm">
			<CardStat Icon="timer" Value="Session.GetFormattedDuration()"/>
			<CardStat Icon="swords" Value="Session.Matches.Count"/>
		</div>
	</div>

	<div class="grid grid-cols-4 gap-x-3 gap-y-6">
		@foreach (var sessionPlayer in Session.Players.OrderBy(sp => sp.SeatNumber))
		{
			<div class="flex flex-col items-center gap-1 text-sm">
				<Avatar Uri="@sessionPlayer.Player.AvatarUri" Size="12"/>
				<span>@sessionPlayer.Player.Username</span>
				@{
					var wins = Session.Matches
						.SelectMany(m => m.Participations)
						.Where(p => p.PlayerSlug == sessionPlayer.PlayerSlug)
						.Count(p => p.IsWinner);
				}
				@if (wins > 0)
				{
					<div class="flex text-muted">
						@for (var i = 0; i < wins; i++)
						{
							<span class="icon">trophy</span>
						}
					</div>
				}
			</div>
		}
	</div>
</a>

@code {

	[Parameter, EditorRequired]
    public Session Session { get; set; }

}