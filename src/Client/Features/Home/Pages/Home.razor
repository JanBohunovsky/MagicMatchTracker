@page "/"

<PageTitle>Home</PageTitle>

<div class="card flex flex-col gap-2 md:mx-auto md:w-100">
	<h2>Info card</h2>
	<p>Lorem ipsum dolor sit amet, consetetur sadipscing elitr, sed diam nonumy eirmod tempor invidunt ut labore et dolore magna aliquyam erat, sed diam voluptua.</p>
	<p class="text-muted italic">Here's some additional information.</p>
	<div class="mt-2 flex gap-2">
		<button class="button inverted-component"><span class="icon">language</span><span>Website</span></button>
		<button class="button"><span class="icon">mail</span><span>Email</span></button>
	</div>
</div>

<div class="mt-4 card flex flex-col gap-4 md:mx-auto md:w-100">
	<h2>Elimination reasons</h2>
	@foreach (var reason in Enum.GetValues<EliminationReason>())
	{
		<div class="flex items-center gap-2">
			<span class="icon">@reason.Icon</span>
			<div class="flex flex-col">
				<span>@reason.DisplayName</span>
				<span class="text-sm text-muted">@reason.Description</span>
			</div>
		</div>
	}
</div>