<NavLink href="@Target" Match="LinkMatch" ActiveClass="active [.active]:text-on-surface [.active]:icon-filled [.active]:bg-surface"
         class="px-4 py-2 transition rounded-t-surface text-on-surface-inactive flex flex-col gap-x-1 md:flex-row md:rounded-badge items-center justify-center
				hover:bg-surface hover:text-on-surface hover:cursor-pointer">
	<div class="flex">
		<span class="icon" aria-hidden="true">@Icon</span>
	</div>
	<span class="text-sm md:text-base">@Label</span>
</NavLink>

@code {

	[Parameter, EditorRequired]
    public required string Target { get; set; }

	[Parameter, EditorRequired]
    public required string Icon { get; set; }

	[Parameter, EditorRequired]
    public required string Label { get; set; }

	[Parameter]
    public NavLinkMatch LinkMatch { get; set; } = NavLinkMatch.Prefix;

}