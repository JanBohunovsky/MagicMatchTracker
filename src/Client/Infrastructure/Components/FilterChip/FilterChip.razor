@typeparam T

<div class="@(IsSelected ? "selected" : string.Empty)">
	<InputRadio class="hidden"
	            Value="Item.Id" id="@Item.Id"/>
	<label class="button component-on-background flex items-center gap-1 py-1 px-3 text-sm in-[.selected]:bg-inverted-component in-[.selected]:text-on-inverted-component in-[.selected]:border-transparent"
	       for="@Item.Id">
		@if (IsSelected)
		{
			<span class="icon">check</span>
		}
		<span>@Item.Label</span>
	</label>
</div>

@code {

	[Parameter, EditorRequired]
    public FilterItem<T> Item { get; set; }

	[Parameter, EditorRequired]
    public bool IsSelected { get; set; }

}